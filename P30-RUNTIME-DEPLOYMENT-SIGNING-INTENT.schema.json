{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yowthi.local/schemas/p30-runtime-deployment-signing-intent.schema.json",
  "title": "YowThi P30 Runtime Deployment Signing Intent",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","signingIntentId","approvalId","requestId","requestSha256","executorSha256","issuedUtc","expiresUtc","nonce","action"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "signingIntentId": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$" },
    "approvalId": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$" },
    "requestId": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$" },
    "requestSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "executorSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "issuedUtc": { "type": "string", "format": "date-time" },
    "expiresUtc": { "type": "string", "format": "date-time" },
    "nonce": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$" },
    "action": { "const": "runtime-deploy" }
  }
}
