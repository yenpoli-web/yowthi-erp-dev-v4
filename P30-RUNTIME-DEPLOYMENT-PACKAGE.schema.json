{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yowthi.local/schemas/p30-runtime-deployment-package.schema.json",
  "title": "YowThi P30 Runtime Deployment Package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","packageId","createdUtc","deploymentEnabled","components","signerKey","approvalBridge"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageId": { "type": "string", "pattern": "^p30-[0-9A-Fa-f]{32}$" },
    "createdUtc": { "type": "string", "format": "date-time" },
    "deploymentEnabled": { "const": false },
    "components": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name","installFileName","exeSha256"],
        "properties": {
          "name": { "enum": ["signer","authorizer","executor"] },
          "installFileName": { "type": "string", "minLength": 1 },
          "exeSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" }
        }
      }
    },
    "signerKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyName","keyId","spkiSha256","provisioned"],
      "properties": {
        "keyName": { "const": "YowThiRuntimeDeploymentSignerV1" },
        "keyId": { "const": "p30-runtime-deployment-signer-v1" },
        "spkiSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "provisioned": { "const": false }
      }
    },
    "approvalBridge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installFileName","exeSha256","provisioned"],
      "properties": {
        "installFileName": { "const": "YowThi.RuntimeDeploymentApprovalBridge.exe" },
        "exeSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
        "provisioned": { "const": false }
      }
    }
  }
}
