{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yowthi.local/schemas/p28-runtime-deployment-authorization.schema.json",
  "title": "YowThi P28 Runtime Deployment Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "authorizationId",
    "requestId",
    "requestSha256",
    "releaseName",
    "currentRuntimeDll",
    "currentRuntimeSha256",
    "currentProcessId",
    "targetRuntimeDll",
    "targetRuntimeSha256",
    "listenUrl",
    "healthUrl",
    "supervisorExe",
    "supervisorSha256",
    "executorSha256",
    "processAuthorization",
    "authorizedUtc",
    "expiresUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorizationId": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$" },
    "requestId": { "type": "string", "pattern": "^[0-9A-Fa-f]{32}$" },
    "requestSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "releaseName": { "type": "string", "pattern": "^r[0-9]+$" },
    "currentRuntimeDll": { "type": "string", "minLength": 1 },
    "currentRuntimeSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "currentProcessId": { "type": "integer", "minimum": 1 },
    "targetRuntimeDll": { "type": "string", "minLength": 1 },
    "targetRuntimeSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "listenUrl": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/?$" },
    "healthUrl": { "type": "string", "pattern": "^http://127\\.0\\.0\\.1:[0-9]+/health/?$" },
    "supervisorExe": { "type": "string", "minLength": 1 },
    "supervisorSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "executorSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "processAuthorization": { "const": true },
    "authorizedUtc": { "type": "string", "format": "date-time" },
    "expiresUtc": { "type": "string", "format": "date-time" }
  }
}
